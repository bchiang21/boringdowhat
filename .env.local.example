# Copy this to .env.local and fill in your values

# Your site's public URL (used in approve/reject email links)
NEXT_PUBLIC_SITE_URL=https://boringdowhat.com

# SMTP settings for sending review emails
# Works with Gmail (use an App Password), Mailgun, Postmark, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Who the email appears to come from (defaults to SMTP_USER)
EMAIL_FROM=hello@boringdowhat.com

# Where review emails are sent (defaults to hello@boringdowhat.com)
EMAIL_TO=hello@boringdowhat.com

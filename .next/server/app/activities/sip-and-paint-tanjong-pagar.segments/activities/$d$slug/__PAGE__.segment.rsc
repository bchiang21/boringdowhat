3:[["$","hr",null,{"className":"border-gray-100 mb-10"}],["$","section",null,{"className":"mb-10","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-900 mb-4","children":"What to expect"}],["$","div",null,{"className":"space-y-4","children":[["$","p","0",{"className":"text-gray-600 leading-relaxed","children":"You'll arrive to find your canvas set up with a light pencil sketch guide and your first glass of wine poured. The session is guided — a Canvas & Co. artist walks through the painting step by step — but the pace is loose and the music is good."}],["$","p","1",{"className":"text-gray-600 leading-relaxed","children":"The subject changes each session: landscapes, botanicals, abstract colour fields. You won't know the exact painting until you arrive, which keeps regulars coming back."}],["$","p","2",{"className":"text-gray-600 leading-relaxed","children":"Everyone leaves with a finished (or at least complete) piece. Canvas & Co. provides all materials — brushes, acrylics, canvas, aprons. Just bring yourself and a willingness to ruin a shirt."}]]}]]}]]

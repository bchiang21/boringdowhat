[{"id":"1","slug":"terrarium-making-queenstown","title":"Terrarium Making","provider":"The Green Fingers Studio","description":"Build your own little world in a glass jar. No prior experience needed — just a love for plants and a willingness to get your hands dirty. Perfect for unwinding after a long week.","location":"Queenstown","duration":"2h","price":68,"pax":"1–8","image":"/images/terrarium.jpg","tags":["burned-out","introvert","solo"],"category":"Craft","featured":true},{"id":"2","slug":"sip-and-paint-tanjong-pagar","title":"Sip & Paint Session","provider":"Canvas & Co.","description":"Wine, brushes, and zero judgment. A casual guided painting session where the vibe matters more than the art. Great for solo evenings or small groups.","location":"Tanjong Pagar","duration":"2.5h","price":75,"pax":"1–20","image":"/images/paint.jpg","tags":["burned-out","introvert","creative"],"category":"Art","featured":true},{"id":"3","slug":"bread-baking-tiong-bahru","title":"Sourdough Bread Baking","provider":"Proof Bakehouse","description":"Learn the fundamentals of sourdough from a proper baker. You'll leave with a loaf you actually made, and the knowledge to do it again at home.","location":"Tiong Bahru","duration":"3h","price":95,"pax":"1–12","image":"/images/bread.jpg","tags":["burned-out","educational","solo"],"category":"Culinary","featured":false},{"id":"4","slug":"candle-workshop-bugis","title":"Candle Making Workshop","provider":"Wax & Wick","description":"Pour, scent, and set your own soy candles. Choose your fragrance, pick your vessel, and take home something you actually made. Slow, meditative, and genuinely satisfying.","location":"Bugis","duration":"2h","price":55,"pax":"1–15","image":"/images/candle.jpg","tags":["burned-out","introvert","creative"],"category":"Craft","featured":false},{"id":"5","slug":"hawker-cook-off-various","title":"Hawker Cook-Off Challenge","provider":"Team Kopi","description":"Teams compete to cook a classic Singapore hawker dish from scratch. Think char kway teow, laksa, or nasi lemak — judged blind. Messy, loud, and genuinely bonding.","location":"Various (island-wide)","duration":"3h","price":55,"pax":"10–40","image":"/images/hawker.jpg","tags":["team-bonding","active"],"category":"Culinary","featured":true},{"id":"6","slug":"escape-room-clarke-quay","title":"Escape Room + Team Debrief","provider":"Locked SG","description":"A proper escape room followed by a structured team debrief. You'll learn more about how your team communicates under pressure than any workshop could teach you.","location":"Clarke Quay","duration":"2h","price":45,"pax":"6–30","image":"/images/escape.jpg","tags":["team-bonding","educational"],"category":"Adventure","featured":true},{"id":"7","slug":"improv-for-workplaces-cbd","title":"Improv for Workplaces","provider":"Yes And SG","description":"No scripts, no presentations — just your team learning to listen, adapt, and say yes to each other. Improv exercises that translate directly into better collaboration.","location":"CBD","duration":"3h","price":65,"pax":"10–30","image":"/images/improv.jpg","tags":["team-bonding","educational"],"category":"Wellness","featured":false},{"id":"8","slug":"amazing-race-singapore","title":"Amazing Race SG","provider":"Rally Co.","description":"A city-wide scavenger hunt across Singapore's neighbourhoods. Clues, checkpoints, and a fair amount of arguing about which MRT line to take. Good luck.","location":"City-wide","duration":"3.5h","price":40,"pax":"15–60","image":"/images/race.jpg","tags":["team-bonding","active"],"category":"Adventure","featured":true},{"id":"9","slug":"kids-pottery-holland-village","title":"Kids Pottery Class","provider":"Clay Play Studio","description":"Hands-on clay sessions designed for kids aged 5–12. They build, squish, and shape — and walk away with something fired and glazed to take home. Parents welcome to join.","location":"Holland Village","duration":"1.5h","price":48,"pax":"1–10 kids","image":"/images/pottery.